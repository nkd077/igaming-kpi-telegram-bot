# Token from @BotFather
BOT_TOKEN=

# Chats allowed to use the bot, comma-separated. Send /id to the bot to get one.
# Leave empty only for a public demo.
ALLOWED_CHAT_IDS=

# Where the morning digest goes (defaults to ALLOWED_CHAT_IDS)
DIGEST_CHAT_IDS=

DIGEST_TIME=09:00
TIMEZONE=Europe/London

# CSV with columns: date, channel, spend, registrations, ftds
DATA_PATH=demo_data/daily.csv
